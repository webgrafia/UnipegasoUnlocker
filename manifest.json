{
   "action": {
      "default_icon": {
         "128": "assets/icons/icon-128.png",
         "16": "assets/icons/icon-16.png",
         "48": "assets/icons/icon-48.png"
      },
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "content_scripts": [ {
      "js": [ "content/patch.js" ],
      "matches": [ "https://*.click/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "content/content.js" ],
      "matches": [ "https://*.click/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.cloudfront.net/;"
   },
   "description": "Autoplay videolezioni Pegaso, Mercatorum e San Raffaele - Automatizza lo scorrimento delle videolezioni",
   "host_permissions": [ "https://*.cloudfront.net/*" ],
   "icons": {
      "128": "assets/icons/icon-128.png",
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "unipegaso unlocker",
   "permissions": [ "tabs", "storage", "downloads" ],
   "version": "1.6.9",
   "web_accessible_resources": [ {
      "matches": [ "https://*.click/*" ],
      "resources": [ "assets/icons/*" ]
   } ]
}
